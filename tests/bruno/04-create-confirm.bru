meta {
  name: 04-create-confirm
  type: http
  seq: 4
}

post {
  url: {{orderUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{runId}}-confirm
}

body:json {
  {
    "items": [
      {
        "productId": "{{productId}}",
        "quantity": 2
      }
    ]
  }
}

script:post-response {
  bru.setVar('confirmedId', res.getBody().orderId);
}

tests {
  test('Expected HTTP status', () => expect(res.getStatus()).to.equal(202));
  test('Acceptance snapshot and location', () => {
    expect(res.getBody().status).to.equal('PENDING');
    expect(res.getHeader('location')).to.equal('/orders/' + res.getBody().orderId);
  });
}
