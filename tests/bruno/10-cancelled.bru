meta {
  name: 10-cancelled
  type: http
  seq: 10
}

get {
  url: {{orderUrl}}/orders/{{cancelledId}}
  body: none
  auth: none
}

tests {
  test('Expected HTTP status', () => expect(res.getStatus()).to.equal(200));
  const terminal = res.getBody().status === 'CANCELLED' && res.getBody().inventoryCancellationStatus === 'COMPLETED';
  const count = bru.getVar('10-cancelled-poll') || 0;
  if (!terminal && count < 120) {
    bru.setVar('10-cancelled-poll', count + 1);
    await new Promise(resolve => setTimeout(resolve, 250));
    bru.setNextRequest('10-cancelled');
  } else {
    test('Terminal state converges', () => expect(terminal).to.equal(true));
  }
}
