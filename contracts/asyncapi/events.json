{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Order and Inventory Events",
    "version": "1.0.0"
  },
  "defaultContentType": "application/json",
  "servers": {
    "local": {
      "host": "localhost:5672",
      "protocol": "amqp"
    }
  },
  "channels": {
    "events": {
      "address": "business.events",
      "messages": {
        "OrderCreated": {
          "$ref": "#/components/messages/OrderCreated"
        },
        "OrderCancelled": {
          "$ref": "#/components/messages/OrderCancelled"
        },
        "StockReserved": {
          "$ref": "#/components/messages/StockReserved"
        },
        "StockRejected": {
          "$ref": "#/components/messages/StockRejected"
        },
        "StockReleased": {
          "$ref": "#/components/messages/StockReleased"
        },
        "ProductStockCreated": {
          "$ref": "#/components/messages/ProductStockCreated"
        },
        "ProductStockReplenished": {
          "$ref": "#/components/messages/ProductStockReplenished"
        },
        "ProductStockUpdated": {
          "$ref": "#/components/messages/ProductStockUpdated"
        }
      }
    }
  },
  "operations": {
    "publish": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/events"
      }
    }
  },
  "components": {
    "messages": {
      "OrderCreated": {
        "name": "OrderCreated",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "eventType": {
              "const": "OrderCreated"
            },
            "schemaVersion": {
              "const": 1
            },
            "aggregateId": {
              "type": "string",
              "format": "uuid"
            },
            "aggregateVersion": {
              "type": "integer",
              "minimum": 1
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "correlationId": {
              "type": "string"
            },
            "causationId": {
              "type": "string"
            },
            "traceparent": {
              "type": "string"
            },
            "producer": {
              "enum": [
                "order-service"
              ]
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "format": "uuid"
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "productId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000000
                      }
                    },
                    "required": [
                      "productId",
                      "quantity"
                    ]
                  }
                }
              },
              "required": [
                "orderId",
                "items"
              ]
            }
          },
          "required": [
            "eventId",
            "eventType",
            "schemaVersion",
            "aggregateId",
            "aggregateVersion",
            "occurredAt",
            "correlationId",
            "causationId",
            "traceparent",
            "producer",
            "payload"
          ]
        }
      },
