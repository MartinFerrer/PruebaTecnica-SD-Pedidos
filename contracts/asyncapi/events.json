                        "maximum": 1000000000
                      },
                      "available": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000
                      },
                      "reason": {
                        "enum": [
                          "INSUFFICIENT_STOCK",
                          "PRODUCT_NOT_FOUND"
                        ]
                      }
                    },
                    "required": [
                      "productId",
                      "requested",
                      "available",
                      "reason"
                    ]
                  }
                }
              },
              "required": [
