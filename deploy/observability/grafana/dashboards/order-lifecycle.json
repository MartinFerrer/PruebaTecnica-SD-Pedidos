{
    "uid": "order-lifecycle",
    "title": "Order lifecycle",
    "schemaVersion": 39,
    "version": 5,
    "refresh": "10s",
    "panels": [
        {
            "type": "timeseries",
            "title": "Pedidos creados",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(rate(orders_total[5m])) or vector(0)",
                    "legendFormat": "created"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "calcs": []
                },
                "tooltip": {"mode": "multi", "sort": "desc"},
                "xAxis": {"mode": "time", "name": "Tiempo", "show": true}
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "decimals": 2,
                    "min": 0,
                    "custom": {
                        "axisLabel": "ops/s",
                        "axisPlacement": "left",
                        "showPoints": "auto"
                    }
                },
                "overrides": []
            }
        },
        {
            "type": "timeseries",
            "title": "Transiciones por estado",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum by (state) (rate(order_state_transitions_total[5m]))",
                    "legendFormat": "{{state}}"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "calcs": []
                },
                "tooltip": {"mode": "multi", "sort": "desc"},
                "xAxis": {"mode": "time", "name": "Tiempo", "show": true}
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "decimals": 2,
                    "min": 0,
                    "custom": {
                        "axisLabel": "ops/s",
                        "axisPlacement": "left",
                        "showPoints": "auto"
                    }
                },
                "overrides": []
            }
        },
        {
            "type": "timeseries",
            "title": "Latencia HTTP",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
                    "legendFormat": "p95"
                }
            ],
            "options": {
                "legend": {"displayMode": "list", "placement": "bottom", "calcs": []},
                "tooltip": {"mode": "multi", "sort": "desc"},
                "xAxis": {"mode": "time", "name": "Tiempo", "show": true}
            },
            "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "min": 0}, "overrides": []}
        },
        {
            "type": "timeseries",
            "title": "Volumen por intervalo",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 16
            },
            "targets": [
                {
                    "expr": "sum(increase(orders_total[$__interval]))",
                    "legendFormat": "Pedidos"
                },
                {
                    "expr": "sum(increase(order_state_transitions_total[$__interval]))",
                    "legendFormat": "Transiciones"
                }
            ],
            "options": {
                "legend": {"displayMode": "list", "placement": "bottom", "calcs": []},
                "tooltip": {"mode": "multi", "sort": "desc"},
                "xAxis": {"mode": "time", "name": "Tiempo", "show": true}
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "decimals": 0,
                    "min": 0,
                    "custom": {
                        "axisLabel": "eventos por intervalo",
                        "axisPlacement": "left",
                        "showPoints": "auto"
                    }
                },
                "overrides": []
            }
        }
    ]
}
